{
  "name": "linkedin-focus-filter",
  "version": "1.0.0",
  "description": "Chrome extension that filters the LinkedIn feed against your interests with an on-device decision model.",
  "scripts": {
    "build": "node build.js",
    "build:debug": "LIF_TELEMETRY=1 node build.js",
    "telemetry": "node telemetry-server.js",
    "dev": "npm run build:debug && node dev-reload.js",
    "eval": "node build-test.js && node eval-run.js",
    "test": "node build-test.js && node .test-build/checks.cjs",
    "bench:baselines": "esbuild src/bench-baselines.js --bundle --platform=node --log-level=warning --outfile=.test-build/baselines.cjs && node .test-build/baselines.cjs"
  },
  "author": "Wagner Silva",
  "type": "commonjs",
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "open-jev": "0.1.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "29.1.1"
  },
  "engines": { "node": ">=18" },
  "private": true,
  "license": "MIT"
}
